// Playwright specs: Node, plus DOM types for page.evaluate() callbacks (not for the rest of the Node code).
{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "lib": [
      "ES2023",
      "DOM"
    ]
  },
  "include": [
    "playwright.config.ts",
    "e2e"
  ]
}
