#!/usr/bin/env bash
# Developer entry point. Every command runs inside the hubbo-toolchain
# container; nothing is installed on the host.
#
#   bin/hubbo test [ctest args]  build the native core and run its tests in parallel
#                             (e.g. `test -R RebootRoundTrip`; tsan and asan take them too)
#   bin/hubbo fw <pio args>   PlatformIO in firmware/ (e.g. `fw run`; builds the web admin first;
#                             HUBBO_FW_VERSION=<label> overrides the image's version)
#   bin/hubbo ota <ip> [--wipe]  build the dev firmware and upload it over Ethernet
#                             (--wipe: erase every setting first, like a new board)
#   bin/hubbo sim <args>      build and run hub-sim (`sim serve`, `sim run <script>`)
#   bin/hubbo tsan            core + sim tests under ThreadSanitizer
#   bin/hubbo asan            core + sim tests under AddressSanitizer + UBSan
#   bin/hubbo shell           interactive shell in the toolchain
#   bin/hubbo run <cmd...>    any command in the toolchain
#   bin/hubbo image           (re)build the toolchain image
#   bin/hubbo web [pnpm args] web admin (default: `dev`, e.g. `web build`)
#   bin/hubbo web e2e [--sim [--auth]] [args]  Playwright e2e against the mock, or (--sim)
#                             against a fresh hub-sim that it starts and stops itself
#   bin/hubbo web e2e --both <specs>  those specs on the mock, then on hub-sim --auth
#                             (the feature check while working)
#   bin/hubbo profiles sync [dir]  copy the built-in profiles from hubbo-devices (default ../hubbo-devices)
#   bin/hubbo gate <core|api|web|fw|all>  an area's full phase-end gate, as one command
#   bin/hubbo gate web --failed  rerun only the e2e spec files the last web gate saw fail
set -euo pipefail

self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
cd "$(dirname "$0")/.."
export HOST_UID="$(id -u)" HOST_GID="$(id -g)"

# Every command gets a fresh container, so it always sees the current
# environment (e.g. HUBBO_OTA_PASSWORD) and mounts. Start-up is under a second.
run_in() {  # <service> <command...>
    local service=$1 tty=(-T)
    shift
    [ -t 0 ] && [ -t 1 ] && tty=()
    docker compose run --rm "${tty[@]}" "$service" "$@"
}

in_toolchain() {
    run_in toolchain "$@"
}

# Take an exclusive lock on <file> as fd <fd>, held until this script exits.
lock() {  # <fd> <file>
    mkdir -p build
    eval "exec $1>\"\$2\""
    flock -w 600 "$1" || { echo "hubbo: $2 is still held after 10 min" >&2; exit 1; }
}

# Rebuild web/dist unless it is newer than every web admin source.
web_build_if_stale() {
    if [ -f web/dist/index.html ] && [ -z "$(find web/src web/public web/index.html profiles \
            web/package.json web/pnpm-lock.yaml web/vite.config.ts web/tsconfig*.json \
            -newer web/dist/index.html -print -quit)" ]; then
        echo "fw: web/dist is up to date"
    else
        run_in web build
    fi
}

# Build a native tree and run ctest. Configures only on first use; after that
# ninja re-runs cmake itself when a CMakeLists.txt or globbed source changes.
#
# Each build dir is guarded by an exclusive lock (`<dir>.lock`), held for the
# build and the test run. Several agents or terminals share these dirs, and
# without the lock one build relinks binaries while another is linking or
# running them, which gives phantom failures and crashes.
native_tests() {  # <service> <build dir> <build type> [ctest args...]
    local service=$1
    shift
    run_in "$service" bash -c '
        dir=$1 type=$2
        shift 2
        mkdir -p build
        exec 9>"$dir.lock"
        flock 9
        { [ -f "$dir/build.ninja" ] ||
            cmake -S . -B "$dir" -G Ninja -DCMAKE_BUILD_TYPE="$type" >/dev/null; } &&
        cmake --build "$dir" &&
        ctest --test-dir "$dir" --output-on-failure -j "$(nproc)" "$@"' _ "$@"
}

# Build hub-sim under the build-dir lock (a shell snippet for in_toolchain).
build_sim='mkdir -p build && exec 9>build/native.lock && flock 9 &&
    { [ -f build/native/build.ninja ] ||
        cmake -S . -B build/native -G Ninja -DCMAKE_BUILD_TYPE=Debug >/dev/null; } &&
    cmake --build build/native --target hub-sim >/dev/null'

cmd="${1:-help}"
shift || true

case "$cmd" in
    test)
        native_tests toolchain build/native Debug "$@"
        ;;
    fw)
        if [ "${1:-}" = run ]; then
            # One firmware build at a time (concurrent pio runs share
            # firmware/.pio). `fw run` embeds web/dist (web_assets.py), so it
            # also holds the web/dist lock, which `web build` takes too: dist
            # can't be rewritten while it's being packed.
            lock 9 build/firmware.lock
            lock 8 build/web-dist.lock
            web_build_if_stale
        fi
        in_toolchain bash -c 'cd firmware && pio "$@"' _ "$@"
        ;;
    ota)
        # Build the dev (_ota) firmware and upload it over Ethernet. Adds only
        # the password handling to `fw`: read from a private file, never
        # printed (any output line containing it is dropped).
        #
        # `--wipe` first uploads a build that erases every setting at boot
        # (admin, tokens, HA token, BLE bonds, remote, config), waits for its
        # WIPE line, then uploads the normal build: the wipe build erases on
        # every boot, so it must never stay on the board.
        ip="${1:?usage: bin/hubbo ota <board ip> [--wipe]}"
        wipe="${2:-}"
        [ -z "$wipe" ] || [ "$wipe" = --wipe ] || { echo "ota: unknown option $wipe" >&2; exit 1; }
        pwfile="${HUBBO_OTA_PASSWORD_FILE:-$HOME/.config/hubbo/ota-password}"
        [ -r "$pwfile" ] || { echo "ota: no password file at $pwfile" >&2; exit 1; }
        pw="$(<"$pwfile")"
        [ "${#pw}" -ge 12 ] || { echo "ota: password in $pwfile is empty or too short" >&2; exit 1; }
        upload() {  # [VAR=value...]: build and upload; output to $log, password lines dropped
            # The filter pattern comes from a file descriptor, so the password
            # never appears in a process argument list.
            env "$@" HUBBO_OTA_PASSWORD="$pw" "$self" fw run -e waveshare_esp32_s3_eth_ota -t upload --upload-port "$ip" 2>&1 |
                grep -vFf <(printf '%s\n' "$pw") | tee "$log"
            return "${PIPESTATUS[0]}"
        }
        log="$(mktemp)"
        trap 'rm -f "$log"' EXIT
        if [ -n "$wipe" ]; then
            echo "ota: uploading the WIPE build to $ip ..."
            upload HUBBO_WIPE_ON_BOOT=1 || { echo "ota: wipe build FAILED" >&2; exit 1; }
            grep -q "HUBBO_WIPE_ON_BOOT: this image ERASES" "$log" ||
                { echo "ota: the build didn't take the wipe flag; uploading the normal build" >&2; wipe=failed; }
            if [ "$wipe" = --wipe ]; then
                echo "ota: waiting for the board to wipe itself ..."
                for _ in $(seq 1 90); do
                    curl -s -m 2 "http://$ip/debug/log" 2>/dev/null | grep -q "^WIPE:" && break
                    sleep 2
                done
                curl -s -m 2 "http://$ip/debug/log" 2>/dev/null | grep "^WIPE:" ||
                    echo "ota: no WIPE line seen; uploading the normal build anyway" >&2
            fi
        fi
        echo "ota: building and uploading to $ip ..."
        set +e
        upload
        status=$?
        set -e
        if [ "$status" -eq 0 ]; then echo "ota: done; the board is rebooting"; else echo "ota: FAILED (exit $status)" >&2; fi
        [ "$wipe" != failed ] || status=1
        exit "$status"
        ;;
    sim)
        # Build under the build-dir lock, then run a private copy, so a later
        # rebuild can't replace the binary under a running sim.
        in_toolchain bash -c "$build_sim"' &&
            cp build/native/sim/hub-sim /tmp/hub-sim && exec 9>&- &&
            exec /tmp/hub-sim "$@"' _ "$@"
        ;;
    tsan)
        native_tests tsan build/tsan RelWithDebInfo "$@"
        ;;
    asan)
        native_tests asan build/asan Debug "$@"
        ;;
    shell)
        in_toolchain bash
        ;;
    run)
        in_toolchain "$@"
        ;;
    image)
        docker compose build toolchain
        ;;
    web)
        [ $# -eq 0 ] && set -- dev
        if [ "$1" = e2e ]; then
            shift
            # Install/update node_modules first, unless the gate already did.
            [ -n "${HUBBO_WEB_READY:-}" ] || run_in web exec true
            # In the gate's parallel e2e, keep the two web-e2e starts a few
            # seconds apart: on this host, two `docker compose run`s of one
            # service starting together sometimes lose their exit code (254).
            stagger() { [ -z "${HUBBO_WEB_READY:-}" ] || flock build/web-e2e-start.lock sleep 4; }
            if [ "${1:-}" = --both ]; then
                # The same specs on the mock, then on hub-sim with sign-in: the
                # feature check while working (e.g. `--both e2e/mqtt.spec.ts`).
                shift
                [ $# -gt 0 ] || { echo "usage: bin/hubbo web e2e --both <specs or playwright args>" >&2; exit 2; }
                export HUBBO_WEB_READY=1
                rc=0
                echo "--- mock"
                "$self" web e2e "$@" || rc=1
                echo "--- hub-sim --auth"
                "$self" web e2e --sim --auth "$@" || rc=1
                exit $rc
            fi
            if [ "${1:-}" != --sim ]; then
                stagger
                run_in web-e2e "$@"
                exit
            fi
            # --sim: run against a hub-sim on fresh data, owned by this command
            # from start to stop, so nobody waits on a server by hand.
            shift
            sim_args=()
            [ "${1:-}" = --auth ] && { sim_args=(--auth); shift; }
            lock 7 build/e2e-sim.lock
            in_toolchain bash -c "$build_sim"' && cp build/native/sim/hub-sim build/e2e-hub-sim'
            sim=hubbo-e2e-sim
            trap 'docker rm -f "$sim" >/dev/null 2>&1 || true' EXIT
            docker rm -f "$sim" >/dev/null 2>&1 || true
            docker compose run -d --rm -T --name "$sim" toolchain build/e2e-hub-sim \
                serve --port 8780 --data build/sim-e2e --reset "${sim_args[@]}" >/dev/null
            for _ in $(seq 1 60); do
                curl -s -m 1 -o /dev/null http://127.0.0.1:8780/api/v1/auth/session && break
                sleep 0.5
            done
            stagger
            HUBBO_API_TARGET=http://127.0.0.1:8780 run_in web-e2e "$@"
        else
            [ "$1" = build ] && lock 8 build/web-dist.lock
            run_in web "$@"
        fi
        ;;
    profiles)
        # Copy the built-in profiles, kinds.json and buttons.json from
        # hubbo-devices into profiles/, byte for byte, after its validator
        # passes, and write profiles/index.json (id, revision, sha256 per file).
        [ "${1:-}" = sync ] || { echo "usage: bin/hubbo profiles sync [hubbo-devices dir]" >&2; exit 2; }
        src="$(cd "${2:-../hubbo-devices}" && pwd)"
        "$src/bin/validate" >/dev/null
        hashes="$("$src/bin/validate" --hashes profiles)"
        rm -f profiles/*.json
        mkdir -p profiles
        cp "$src"/profiles/*.json "$src/kinds.json" "$src/buttons.json" profiles/
        printf '%s\n' "$hashes" | awk -F'\t' '
            BEGIN { print "[" }
            { n = split($4, p, "/"); printf "%s  {\"file\": \"%s\", \"id\": \"%s\", \"revision\": %s, \"sha256\": \"%s\"}", (NR > 1 ? ",\n" : ""), p[n], $1, $2, $3 }
            END { print "\n]" }' >profiles/index.json
        echo "profiles: synced $(printf '%s\n' "$hashes" | wc -l) profiles from $src"
        ;;
    gate)
        # One area's full phase-end gate, stopping at the first failure. Run it
        # once per phase; while working, run only what a change touches.
        gate_core() { "$self" test && "$self" tsan && "$self" asan; }
        gate_api() { api/lint.sh && api/contract.sh; }
        # The mock e2e and the hub-sim e2e use separate ports, output dirs and
        # caches, so they run side by side. The hub-sim branch logs to its own
        # file (printed after) so the two reporters don't interleave.
        # Every failed e2e spec file goes to build/gate-web-failed.txt, so
        # `gate web --failed` reruns just those instead of the whole gate.
        failed_list=build/gate-web-failed.txt
        gate_web() {
            "$self" web exec true || return 1  # install once, for both branches
            mkdir -p build
            local sim_log=build/gate-web-sim.log mock_log=build/gate-web-mock.log rc=0 sim
            (
                export HUBBO_WEB_READY=1
                "$self" web e2e --sim --auth && "$self" web e2e --sim --project=noauth
            ) >"$sim_log" 2>&1 &
            sim=$!
            { "$self" web check && "$self" web build && HUBBO_WEB_READY=1 "$self" web e2e; } 2>&1 \
                | tee "$mock_log"
            [ "${PIPESTATUS[0]}" -eq 0 ] || rc=1
            wait "$sim" || rc=1
            echo "--- hub-sim e2e"
            cat "$sim_log"
            cat "$mock_log" "$sim_log" | grep '✘' | grep -oE 'e2e/[A-Za-z0-9_./-]+\.spec\.ts' \
                | sort -u >"$failed_list" || true
            if [ -s "$failed_list" ]; then
                echo "--- failed specs (rerun with: bin/hubbo gate web --failed)"
                cat "$failed_list"
            fi
            return $rc
        }
        # Rerun only the spec files the last `gate web` saw fail, on the mock and on
        # hub-sim (and the noauth project, for its specs). Clears the list on a pass.
        gate_web_failed() {
            [ -s "$failed_list" ] || { echo "gate: no failed web specs recorded" >&2; return 0; }
            local specs rc=0
            mapfile -t specs <"$failed_list"
            echo "--- rerunning: ${specs[*]}"
            "$self" web e2e --both "${specs[@]}" || rc=1
            local noauth=()
            for s in "${specs[@]}"; do
                case "$s" in */firmware.spec.ts | */tokens.spec.ts) noauth+=("$s") ;; esac
            done
            if [ ${#noauth[@]} -gt 0 ]; then
                HUBBO_WEB_READY=1 "$self" web e2e --sim --project=noauth "${noauth[@]}" || rc=1
            fi
            [ $rc -eq 0 ] && : >"$failed_list"
            return $rc
        }
        gate_fw() { "$self" fw run && "$self" fw run -e waveshare_esp32_s3_eth_ota; }
        case "${1:-}" in
            web) if [ "${2:-}" = --failed ]; then gate_web_failed; else gate_web; fi ;;
            core | api | fw) "gate_$1" ;;
            all) gate_core && gate_api && gate_web && gate_fw ;;
            *) echo "usage: bin/hubbo gate <core|api|web|fw|all>" >&2; exit 2 ;;
        esac
        ;;
    *)
        sed -n '/^set -euo/q; s/^#   //p' "$0"
        ;;
esac
