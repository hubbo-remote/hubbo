      }
    ],
    "volume_down:down": [
      {
        "integration_id": "ha_main",
        "device_id": "dev_denon",
        "command_id": "media_player.volume_down",
        "params": {}
      }
    ],
    "mute:down": [
      {
        "integration_id": "ha_main",
        "device_id": "dev_denon",
        "command_id": "media_player.mute_toggle",
        "params": {}
      }
    ],
    "play:down": [
      {
        "integration_id": "ha_main",
        "device_id": "dev_xbox",
        "command_id": "media_player.media_play_pause",
        "params": {}
      }
    ],
    "pause:down": [
      {
        "integration_id": "ha_main",
        "device_id": "dev_xbox",
        "command_id": "media_player.media_play_pause",
        "params": {}
      }
    ],
    "skip_forward:down": [
      {
        "integration_id": "ha_main",
        "device_id": "dev_xbox",
        "command_id": "media_player.media_next_track",
        "params": {}
      }
    ],
    "skip_backward:down": [
      {
        "integration_id": "ha_main",
        "device_id": "dev_xbox",
        "command_id": "media_player.media_previous_track",
        "params": {}
      }
    ],
    "light_1:down": [
      {
        "integration_id": "ha_main",
        "device_id": "dev_family_room_lights",
