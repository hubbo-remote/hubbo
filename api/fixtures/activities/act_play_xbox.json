{
  "id": "act_play_xbox",
  "name": "Play Xbox",
  "startup": [
    {
      "integration_id": "ha_main",
      "device_id": "dev_xbox",
      "command_id": "media_player.turn_on",
      "params": {}
    },
    {
      "integration_id": "ha_main",
      "device_id": "dev_lg_tv",
      "command_id": "media_player.turn_on",
      "params": {}
    },
    {
      "integration_id": "ha_main",
      "device_id": "dev_denon",
      "command_id": "media_player.turn_on",
      "params": {}
    },
    {
      "integration_id": "system",
      "device_id": null,
      "command_id": "wait",
      "params": {
        "duration_ms": 2000
      }
    },
    {
      "integration_id": "ha_main",
      "device_id": "dev_lg_tv",
      "command_id": "media_player.select_source",
      "params": {
        "source": "HDMI 2"
      }
