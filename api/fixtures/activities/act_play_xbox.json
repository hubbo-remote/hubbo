    {
      "integration_id": "ha_main",
      "device_id": "dev_denon",
      "command_id": "media_player.select_sound_mode",
      "params": {
        "sound_mode": "GAME"
      }
    }
  ],
  "shutdown": [
    {
      "integration_id": "ha_main",
      "device_id": "dev_xbox",
      "command_id": "media_player.turn_off",
      "params": {}
    },
    {
      "integration_id": "ha_main",
      "device_id": "dev_lg_tv",
