    "info:down": [
      {
        "integration_id": "ha_main",
        "device_id": "dev_lg_tv",
        "command_id": "call_service",
        "params": {},
        "call": {
          "service": "webostv.button",
          "data": {
            "button": "INFO"
          }
        }
      }
