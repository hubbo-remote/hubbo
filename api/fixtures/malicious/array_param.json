{
  "name": "Watch Apple TV",
  "startup": [
    {
      "integration_id": "ha_main",
      "device_id": "dev_family_room_lights",
      "command_id": "light.turn_on",
      "params": {
        "brightness": [
          255,
          {
            "entity_id": "light.all"
          }
        ]
      }
    }
  ],
  "shutdown": [
    {
      "integration_id": "ble",
      "device_id": "dev_apple_tv",
      "command_id": "press",
      "params": {
        "command": "Home",
        "hold_ms": 2000
      }
    },
    {
      "integration_id": "ble",
      "device_id": "dev_apple_tv",
      "command_id": "press",
      "params": {
        "command": "Select"
      }
    },
    {
      "integration_id": "ha_main",
      "device_id": "dev_lg_tv",
      "command_id": "media_player.turn_off",
      "params": {}
    },
    {
      "integration_id": "ha_main",
      "device_id": "dev_sonos",
      "command_id": "media_player.media_pause",
      "params": {}
    }
  ],
  "bindings": {
    "up:down": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press_down",
        "params": {
          "command": "DirectionUp"
        }
      }
    ],
    "up:up": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press_up",
        "params": {
          "command": "DirectionUp"
        }
      }
    ],
    "down:down": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press_down",
        "params": {
          "command": "DirectionDown"
        }
      }
    ],
    "down:up": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press_up",
        "params": {
          "command": "DirectionDown"
        }
      }
    ],
    "left:down": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press_down",
        "params": {
          "command": "DirectionLeft"
        }
      }
    ],
    "left:up": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press_up",
        "params": {
          "command": "DirectionLeft"
        }
      }
    ],
    "right:down": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press_down",
        "params": {
          "command": "DirectionRight"
        }
      }
    ],
    "right:up": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press_up",
        "params": {
          "command": "DirectionRight"
        }
      }
    ],
    "select:down": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press_down",
        "params": {
          "command": "Select"
        }
      }
    ],
    "select:up": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press_up",
        "params": {
          "command": "Select"
        }
      }
    ],
    "back:down": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press_down",
        "params": {
          "command": "Back"
        }
      }
    ],
    "back:up": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press_up",
        "params": {
          "command": "Back"
        }
      }
    ],
    "exit:down": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press_down",
        "params": {
          "command": "Back"
        }
      }
    ],
    "exit:up": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press_up",
        "params": {
          "command": "Back"
        }
      }
    ],
    "skip_forward:down": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press_down",
        "params": {
          "command": "NextTrack"
        }
      }
    ],
    "skip_forward:up": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press_up",
        "params": {
          "command": "NextTrack"
        }
      }
    ],
    "skip_backward:down": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press_down",
        "params": {
          "command": "PreviousTrack"
        }
      }
    ],
    "skip_backward:up": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press_up",
        "params": {
          "command": "PreviousTrack"
        }
      }
    ],
    "play:down": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press_down",
        "params": {
          "command": "PlayPause"
        }
      }
    ],
    "play:up": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press_up",
        "params": {
          "command": "PlayPause"
        }
      }
    ],
    "pause:down": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press_down",
        "params": {
          "command": "PlayPause"
        }
      }
    ],
    "pause:up": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press_up",
        "params": {
          "command": "PlayPause"
        }
      }
    ],
    "record:down": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "usage_down",
        "params": {
          "usage": 178
        }
      }
    ],
    "record:up": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "usage_up",
        "params": {
          "usage": 178
        }
      }
    ],
    "blue:down": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "key_down",
        "params": {
          "key": "F1"
        }
      }
    ],
    "blue:up": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "key_up",
        "params": {
          "key": "F1"
        }
      }
    ],
    "menu:tap": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press",
        "params": {
          "command": "Home"
        }
      }
    ],
    "menu:hold": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "press",
        "params": {
          "command": "ControlCenter"
        }
      }
    ],
    "info:hold": [
      {
        "integration_id": "ble",
        "device_id": "dev_apple_tv",
        "command_id": "key_tap",
        "params": {
          "key": "KEY_I"
        }
      }
    ],
    "volume_up:down": [
      {
        "integration_id": "ha_main",
        "device_id": "dev_sonos",
        "command_id": "media_player.volume_up",
        "params": {}
      }
    ],
    "volume_down:down": [
      {
        "integration_id": "ha_main",
        "device_id": "dev_sonos",
        "command_id": "media_player.volume_down",
        "params": {}
      }
    ],
    "mute:down": [
      {
        "integration_id": "ha_main",
        "device_id": "dev_sonos",
        "command_id": "media_player.volume_mute",
        "params": {
          "muted": true
        }
      }
    ],
    "plus:down": [
      {
        "integration_id": "ha_main",
        "device_id": "dev_family_room_lights",
        "command_id": "light.brightness_step",
        "params": {
          "step": 32
        }
      }
    ],
    "minus:down": [
      {
        "integration_id": "ha_main",
        "device_id": "dev_family_room_lights",
        "command_id": "light.brightness_step",
        "params": {
          "step": -32
        }
      }
    ],
    "light_1:down": [
      {
        "integration_id": "ha_main",
        "device_id": "dev_family_room_lights",
        "command_id": "light.turn_on",
        "params": {
          "brightness": 255,
          "transition": 1
        }
      }
    ],
    "light_2:down": [
      {
        "integration_id": "ha_main",
        "device_id": "dev_family_room_lights",
        "command_id": "light.turn_off",
        "params": {
          "transition": 1
        }
      }
    ]
  }
}
