{
  "device_id": "dev_family_room_lights",
  "integration_id": "ha_main",
  "commands": [
    {
      "command_id": "light.turn_on",
      "label": "Turn on",
      "effect": "momentary",
      "params": [
        {
          "name": "brightness",
          "type": "int",
          "required": false,
          "minimum": 0,
          "maximum": 255,
          "step": 1
        },
        {
          "name": "color_temp_kelvin",
          "type": "int",
          "required": false,
          "minimum": 2000,
          "maximum": 6535,
          "step": 1
        },
        {
          "name": "transition",
          "type": "number",
          "required": false,
          "minimum": 0,
          "maximum": 300
        }
      ]
    },
    {
      "command_id": "light.turn_off",
      "label": "Turn off",
      "effect": "momentary",
      "params": [
        {
          "name": "transition",
          "type": "number",
          "required": false,
          "minimum": 0,
          "maximum": 300
        }
      ]
    },
    {
      "command_id": "light.brightness_step",
      "label": "Change brightness",
      "effect": "momentary",
      "params": [
        {
          "name": "step",
          "type": "int",
          "required": true,
          "minimum": -255,
          "maximum": 255,
          "step": 1
        },
        {
          "name": "transition",
          "type": "number",
          "required": false,
          "minimum": 0,
          "maximum": 300
        }
      ]
    }
  ]
}
