# A failed step is reported and the next one starts at once: the run goes
# to its end, completed_with_errors with its first failure. No retries.
ha fail media_player.turn_on adapter_failed
activate act_watch_apple_tv
expect ha_main dev_lg_tv media_player.turn_on -> failed adapter_failed
expect ha_main dev_denon media_player.turn_on
expect system - wait duration_ms=1000
advance 1000
expect ha_main dev_lg_tv media_player.select_source source="HDMI 1"
expect ha_main dev_denon media_player.select_source source="Media Player"
expect_event startup act_watch_apple_tv completed_with_errors adapter_failed@0
expect_none
expect_active act_watch_apple_tv
