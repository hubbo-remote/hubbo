# Home Assistant reports a timeout: the sequence stops there.
ha fail media_player.turn_on adapter_timeout
activate act_watch_apple_tv
expect ha_main dev_lg_tv media_player.turn_on -> timeout
expect_event startup act_watch_apple_tv failed adapter_timeout@0
expect_none

# A result that never comes back times out after 5 s, and the late result
# is ignored.
reset
ha latency 6000
activate act_watch_apple_tv
expect ha_main dev_lg_tv media_player.turn_on -> pending
advance 4999
expect_none
advance 1
expect_event startup act_watch_apple_tv failed adapter_timeout@0
advance 2000
expect_none
